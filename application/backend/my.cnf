[mysqld]
bind-address = 0.0.0.0

# Performance tuning
max_connections = 200
innodb_buffer_pool_size = 256M
innodb_log_file_size = 64M

# Logging
general_log = 1
general_log_file = /var/log/mysql/general.log

# Charset
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
